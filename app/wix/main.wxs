<!--
  Windows installer for CTRL Desk (WiX Toolset v5). Built by scripts/package.sh:

    wix build app/wix/main.wxs -arch x64 -d Version=0.2.0 -d Exe=...\desk-ctrl.exe
      -d Icon=...\icon.ico -d Docs=<dir with README.md and LICENSE-Inter-OFL.txt> -o out.msi

  Installs per user into %LOCALAPPDATA%\Programs\CTRL Desk, so installing and
  updating need no administrator rights. The in-app updater relies on that path
  and on the UpgradeCode staying the same, so newer MSIs replace older ones.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="CTRL Desk"
    Manufacturer="CTRL Desk"
    Version="$(Version)"
    UpgradeCode="87DBEFDB-E289-475E-833B-18B8CB2ED9A3"
    Scope="perUser"
    Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of CTRL Desk is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(Icon)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/CypherNaught-0x/CTRL-Desk" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <!-- Start the app when the install finishes. Pass LAUNCHAPP=0 to skip. -->
    <Property Id="LAUNCHAPP" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="CTRL Desk" />
      </Directory>
    </StandardDirectory>

    <!-- Per-user components use an HKCU value as key path (ICE38/ICE57). Keep the
         component GUIDs stable across releases. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="0C9F8D6F-46DE-42C2-AFCA-E8FF4751EA2A">
        <File Id="DeskCtrlExe" Source="$(Exe)" />
        <RegistryValue Root="HKCU" Key="Software\CTRL Desk" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
      </Component>
      <Component Id="Docs" Guid="19564BD1-9065-4438-80BD-FD3513D1101B">
        <File Id="Readme" Source="$(Docs)\README.md" />
        <File Id="FontLicense" Source="$(Docs)\LICENSE-Inter-OFL.txt" />
        <RegistryValue Root="HKCU" Key="Software\CTRL Desk" Name="Docs" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut
          Id="AppShortcut"
          Name="CTRL Desk"
          Description="Control your standing desk over Bluetooth"
          Target="[INSTALLFOLDER]desk-ctrl.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\CTRL Desk" Name="Shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <CustomAction Id="LaunchApp" FileRef="DeskCtrlExe" ExeCommand="" Return="asyncNoWait" Impersonate="yes" />
    <InstallExecuteSequence>
      <Custom Action="LaunchApp" After="InstallFinalize" Condition="LAUNCHAPP = 1 AND NOT Installed AND NOT REMOVE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
